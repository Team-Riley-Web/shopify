# Shopify Storefront API. The PUBLIC_ copies ship in the browser bundle (the
# Storefront token is designed to be public); the un-prefixed copies are read
# at build time only.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_CHECKOUT_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-01
SHOPIFY_STOREFRONT_TOKEN=

PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_CHECKOUT_DOMAIN=your-store.myshopify.com
PUBLIC_SHOPIFY_API_VERSION=2026-01
PUBLIC_SHOPIFY_STOREFRONT_TOKEN=

# Comma-separated domains this static site is served from. Checkout is never
# sent to one of these; it falls back to the store domain.
PUBLIC_HEADLESS_DOMAINS=example.com,www.example.com

# Serve the demo catalog instead of calling Shopify (local + CI test builds).
SHOPIFY_USE_MOCKS=false
PUBLIC_SHOPIFY_USE_MOCKS=false
