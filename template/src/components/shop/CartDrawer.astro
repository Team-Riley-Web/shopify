---
import { Minus, Plus, X } from '@lucide/astro';
/* Mount once per page (BaseLayout is the natural home). Driven entirely by
   $store.cart; see @team-riley/shopify createCartStore for the members. */
---

<div
  x-data
  x-cloak
  x-show="$store.cart.isOpen"
  x-transition.opacity
  @click="$store.cart.close()"
  class="fixed inset-0 z-40 bg-neutral-900/40"
  aria-hidden="true"
></div>

<aside
  x-data
  x-cloak
  x-show="$store.cart.isOpen"
  x-transition:enter="transition ease-out duration-200"
  x-transition:enter-start="translate-x-full"
  x-transition:enter-end="translate-x-0"
  x-transition:leave="transition ease-in duration-150"
  x-transition:leave-start="translate-x-0"
  x-transition:leave-end="translate-x-full"
  @keydown.escape.window="$store.cart.close()"
  class="fixed right-0 top-0 z-50 flex h-full w-full max-w-md flex-col bg-white shadow-xl"
  role="dialog"
  aria-modal="true"
  aria-label="Shopping cart"
  x-effect="if ($store.cart.isOpen) $nextTick(() => $el.querySelector('[data-close]')?.focus())"
>
  <header class="flex items-center justify-between border-b border-neutral-200 px-6 py-4">
    <h2 class="text-base font-semibold text-neutral-900">
      Your cart
      <span x-show="$store.cart.totalQuantity > 0" x-text="`(${$store.cart.totalQuantity})`" class="font-normal text-neutral-500"></span>
    </h2>
    <button type="button" data-close @click="$store.cart.close()" class="rounded-md p-2 text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900" aria-label="Close cart">
      <X class="h-5 w-5" />
    </button>
  </header>

  <p x-show="$store.cart.errorMessage" x-text="$store.cart.errorMessage" role="alert" class="mx-6 mt-4 rounded-md bg-red-50 px-4 py-3 text-sm text-red-700"></p>

  <div x-show="$store.cart.items.length === 0 && !$store.cart.isLoading" class="flex flex-1 flex-col items-center justify-center gap-4 px-6 text-center">
    <p class="text-neutral-600">Your cart is empty</p>
    <button type="button" @click="$store.cart.close()" class="text-sm font-medium text-neutral-900 underline underline-offset-4">Continue Shopping</button>
  </div>

  <ul x-show="$store.cart.items.length > 0" class="flex-1 divide-y divide-neutral-100 overflow-y-auto px-6">
    <template x-for="item in $store.cart.items" :key="item.id">
      <li class="flex gap-4 py-4">
        <img :src="item.imageUrl || undefined" :alt="item.productTitle" class="h-20 w-20 shrink-0 rounded-md bg-neutral-100 object-cover" />
        <div class="min-w-0 flex-1">
          <a :href="`/products/${item.productHandle}`" class="line-clamp-2 text-sm font-medium text-neutral-900" x-text="item.productTitle"></a>
          <p x-show="item.variantTitle && item.variantTitle !== 'Default Title'" x-text="item.variantTitle" class="text-xs text-neutral-500"></p>
          <p x-show="item.sellingPlanName" x-text="item.sellingPlanName" class="text-xs text-neutral-500"></p>
          <p class="mt-1 text-sm text-neutral-900" x-text="$store.cart.formatPrice(item.price)"></p>
          <div class="mt-2 inline-flex items-center rounded-md border border-neutral-300">
            <button type="button" @click="$store.cart.updateItem(item.id, item.quantity - 1)" class="p-2 text-neutral-600 hover:text-neutral-900" aria-label="Decrease quantity"><Minus class="h-3.5 w-3.5" /></button>
            <span class="w-8 text-center text-sm tabular-nums" x-text="item.quantity" data-quantity></span>
            <button type="button" @click="$store.cart.updateItem(item.id, item.quantity + 1)" class="p-2 text-neutral-600 hover:text-neutral-900" aria-label="Increase quantity"><Plus class="h-3.5 w-3.5" /></button>
          </div>
        </div>
        <button type="button" @click="$store.cart.removeItem(item.id)" class="self-start rounded-md p-1 text-neutral-400 hover:text-neutral-900" aria-label="Remove item">
          <X class="h-4 w-4" />
        </button>
      </li>
    </template>
  </ul>

  <footer x-show="$store.cart.items.length > 0" class="space-y-3 border-t border-neutral-200 px-6 py-5">
    <div class="flex items-center justify-between text-sm">
      <span class="text-neutral-600">Subtotal</span>
      <span class="font-medium text-neutral-900" x-text="$store.cart.formatPrice($store.cart.totalAmount)"></span>
    </div>
    <p class="text-xs text-neutral-500">Shipping and taxes are calculated at checkout.</p>
    <a :href="$store.cart.checkoutUrl" class="block rounded-md bg-neutral-900 px-5 py-3 text-center text-sm font-medium text-white hover:bg-neutral-700">Checkout</a>
    <button type="button" @click="$store.cart.close()" class="block w-full text-center text-sm text-neutral-600 hover:text-neutral-900">Continue Shopping</button>
  </footer>
</aside>

<style is:global>
  /* Alpine-driven overlays stay hidden until Alpine has initialised. */
  [x-cloak] { display: none !important; }
</style>
