{
  "name": "@team-riley/shopify",
  "version": "1.0.0",
  "description": "Headless Shopify engine for Team Riley Astro storefronts: Storefront API client, catalog, cart, discount links, subscriptions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "template",
    "bin"
  ],
  "bin": {
    "team-riley-shopify": "./bin/init.mjs"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build && git diff --exit-code -- dist"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/node": "^22.20.4"
  }
}
